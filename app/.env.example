# Copy to app/.env and fill in one provider's key. With no key set, the chat
# falls back to an extractive answer (top retrieved snippet) at $0.
# Groq is free and runs openai/gpt-oss-120b (get a key at https://console.groq.com/keys).
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOP_K=5
