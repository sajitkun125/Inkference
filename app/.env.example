# Copy to app/.env and fill in the keys:  cp app/.env.example app/.env
# app/.env is gitignored — this file keeps the shape of the config in git.
# Never put a real key here. All other knobs have defaults in config.py.

# Corpus + local scans
INKFERENCE_DATA_ROOT=.inkference_data_all_books_corrected
INKFERENCE_IMAGES_ROOT=/home/you/Downloads/AlexFiles

# Recognizer. Without this you silently get base TrOCR, which is much worse
# on 18th-century hand. Repo-relative path, absolute path, or a Hub id.
TROCR_MODEL_ID=models/trocr_best_from_bentham

# Post-correction. Keep backend=api: the default `local` runs Qwen3-1.7B on CPU.
CORRECTION_ENABLED=true
CORRECTION_BACKEND=api
CORRECTION_API_BASE=https://api.groq.com/openai/v1
# Deliberately NOT the LLM_MODEL above: Groq meters tokens per model, so sharing one
# model would let a bulk ingest starve Ask the Archive of its rate-limit budget.
CORRECTION_API_MODEL=qwen/qwen3.6-27b
# "none" = API-level thinking switch. Required: qwen3.6 ignores the in-prompt
# /no_think hint, and left thinking it truncates and transcribes its own monologue.
CORRECTION_API_REASONING_EFFORT=none

# Ask the Archive: primary provider, then fallback chain, then extractive.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK=gemini:gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Accounts database (PostgreSQL — required; there is no file-backed fallback)
# ---------------------------------------------------------------------------
# Start one locally:  docker compose -f app/deploy/docker-compose.dev.yml up -d
# The line below is also config.py's default, so locally you can leave it unset.
# Azure Database for PostgreSQL requires TLS: append ?sslmode=require there.
DATABASE_URL=postgresql://inkference:inkference@localhost:5432/inkference

# Runs `alembic upgrade head` at startup, serialised across replicas by an advisory
# lock. Set false once migrations run as a separate release job.
DB_MIGRATE_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Accounts + sessions
# ---------------------------------------------------------------------------
# false = open API (right for a public demo, where a gate locks every visitor out).
INKFERENCE_AUTH_REQUIRED=true
# Send the session cookie only over HTTPS. Leave false for http://localhost;
# every deployment must set it true.
INKFERENCE_COOKIE_SECURE=false

# Signs the short-lived cookie that carries an in-progress sign-in between the
# redirect out to the provider and the callback back. MUST be set, and MUST be the
# same on every replica — a sign-in that starts on one and returns to another fails
# otherwise. Unset, the app generates a per-process key and logs a warning.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INKFERENCE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Federated sign-in (optional — leave blank and those buttons stay greyed out)
# ---------------------------------------------------------------------------
# Each provider's registered redirect URI must be, byte for byte:
#   {INKFERENCE_PUBLIC_BASE_URL}/api/auth/oidc/{google|microsoft}/callback
# Behind a proxy that terminates TLS (Azure Container Apps), set the public URL
# explicitly — otherwise the app builds the redirect from the internal address it
# sees and both providers refuse it. Locally this is http://localhost:8000.
INKFERENCE_PUBLIC_BASE_URL=http://localhost:8000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Entra admin center -> App registrations. The tenant decides who may sign in:
# a tenant GUID = one organisation, `organizations` = any work/school account,
# `common` = also personal Microsoft accounts (whose addresses are self-asserted,
# and therefore refused for account linking — prefer one of the first two).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=organizations

# Secrets — https://console.groq.com/keys, https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
